# ── Firebase (Client SDK — используется в apps/web на клиенте) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (apps/web API routes + services/browser-worker) ──────────
# ЛОКАЛЬНО: путь к JSON service account файлу (НЕ коммитить в git).
# В PRODUCTION (Vercel/Cloud Run): содержимое JSON целиком как секрет
# (Vercel Environment Variable / Google Cloud Secret Manager), либо вообще
# не задавать — тогда Cloud Run использует свой встроенный service account
# (Application Default Credentials), что предпочтительнее.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Google Custom Search JSON API (см. services/browser-worker/src/google/searchProvider.ts) ──
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── browser-worker (Cloud Run) ───────────────────────────────────────────────
PORT=8080

# ── apps/web → browser-worker (если нужен прямой вызов, а не только через Firestore jobs) ──
BROWSER_WORKER_URL=
BROWSER_WORKER_SHARED_SECRET=

# ── Rate limiting ────────────────────────────────────────────────────────────
MAX_ACTIVE_JOBS_PER_USER=3
MAX_JOBS_PER_HOUR_PER_USER=20
